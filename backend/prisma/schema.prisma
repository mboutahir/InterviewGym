// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator pyclient {
  //  The Solution: This block tells Prisma: "Hey, look at my database structure, and strictly generate a JavaScript package that matches it."
  //  You can type prisma.recrui... and VS Code autocompletes to prisma.recruiter.
  provider = "prisma-client-py"
}

datasource db {
  //provider = "postgresql": This tells Prisma which language to speak. If you switched this to "mysql", Prisma would change its internal dictionary to speak MariaDB/MySQL
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  //This creates a strict rule in the database: "No two rows can have the same clerkId."
  //If you try to create a second account with the same Clerk ID, the database will block it. This prevents duplicate user accounts.
  //clerk Authentication as a Service.
  clerkId   String   @unique
  email     String   @unique
  //can be empty because when signing in with only email tbhe db wont crash
  firstName String?
  lastName  String?
  //we need it for example for Show me the newest candidates first
  createdAt DateTime @default(now())

  interviews InterviewSessions[]
}

model InterviewSessions {
  id             String   @id @default(uuid())
  jobTitle       String
  jobDescription String   @db.Text
  resumeText     String   @db.Text
  resumeUrl      String
  status         String   @default("IN PROGRESS")
  feedback       String?  @db.Text //big text
  rating          Int?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  Messages        InterviewMessage[]
}
model InterviewMessage {
  id            String    @id @default(uuid())
  role          String
  content       String
  createdAt     DateTime  @default(now())

  sessionId     String
  Session       InterviewSessions @relation(fields: [sessionId], references: [id])
}
