# Postgres from docker-compose (host port 5433)
DATABASE_URL="postgresql://user:password@localhost:5433/recruiter_db?schema=public"

# LLM: "ollama" (local, free: `ollama serve` + `ollama pull qwen2.5:3b`)
#   or "groq" (cloud, needs GROQ_API_KEY from https://console.groq.com/keys)
LLM_PROVIDER="ollama"
# Optional: override the provider's default model
# LLM_MODEL="qwen2.5:3b"
GROQ_API_KEY="gsk_..."

# Clerk public key (PEM, newlines as \n). Get it from
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# or Clerk Dashboard -> API Keys -> "Show JWT public key"
CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# MinIO from docker-compose
AWS_ENDPOINT_URL="http://localhost:9000"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_BUCKET_NAME="resumes"
AWS_REGION="us-east-1"
